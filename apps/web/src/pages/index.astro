---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d4d40" />
    <meta name="description" content="管理你的日常提醒" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <title>提醒管理 · LINE AI Reminder</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <div class="brand"><span class="brand-mark">◷</span><span>LINE AI<br /><strong>Reminder</strong></span></div>
        <span class="mode-badge">本機測試版</span>
      </header>

      <main>
        <section class="intro">
          <p class="eyebrow">把重要的事，留給對的時間</p>
          <h1>我的提醒</h1>
          <p class="intro-copy">建立、調整與整理你的日常提醒。LINE 通知將在後續階段啟用。</p>
          <div class="identity-row">
            <label for="identity">測試身分</label>
            <select id="identity"><option value="demo-a">使用者 A</option><option value="demo-b">使用者 B</option></select>
          </div>
        </section>

        <div id="notice" class="notice" role="status" aria-live="polite" hidden></div>

        <section class="panel form-panel" id="editor" aria-labelledby="form-heading">
          <div class="section-heading"><div><p class="eyebrow">CREATE A REMINDER</p><h2 id="form-heading">新增提醒</h2></div><span class="heading-icon">＋</span></div>
          <form id="reminder-form">
            <label for="title">提醒內容 <span class="required">必填</span></label>
            <input id="title" name="title" required maxlength="120" placeholder="例如：寄報價單給客戶" autocomplete="off" />

            <label for="notes">備註 <span class="muted">選填</span></label>
            <textarea id="notes" name="notes" rows="2" maxlength="1000" placeholder="補充細節，方便稍後查看"></textarea>

            <div class="field-grid">
              <div><label for="kind">重複方式</label><select id="kind" name="kind"><option value="once">只提醒一次</option><option value="daily">每天</option><option value="weekly">每週</option><option value="monthly">每月指定日期</option><option value="monthly_last_day">每月最後一天</option></select></div>
              <div><label for="timezone">時區</label><input id="timezone" name="timezone" list="timezones" value="Asia/Taipei" required /><datalist id="timezones"><option value="Asia/Taipei"></option><option value="Asia/Tokyo"></option><option value="America/New_York"></option><option value="Europe/London"></option></datalist></div>
            </div>

            <div id="once-fields"><label for="at-local">提醒時間</label><input id="at-local" name="at-local" type="datetime-local" /></div>
            <div id="time-fields" hidden><label for="time">提醒時刻</label><input id="time" name="time" type="time" value="09:00" /></div>
            <fieldset id="weekly-fields" hidden><legend>星期幾</legend><div class="weekdays"><label><input type="checkbox" name="weekday" value="1" />一</label><label><input type="checkbox" name="weekday" value="2" />二</label><label><input type="checkbox" name="weekday" value="3" />三</label><label><input type="checkbox" name="weekday" value="4" />四</label><label><input type="checkbox" name="weekday" value="5" />五</label><label><input type="checkbox" name="weekday" value="6" />六</label><label><input type="checkbox" name="weekday" value="7" />日</label></div></fieldset>
            <div id="monthly-fields" hidden><label for="day-of-month">每月日期</label><select id="day-of-month" name="day-of-month">{Array.from({ length: 31 }, (_, index) => <option value={index + 1}>{index + 1} 日</option>)}</select><p class="field-hint">遇到沒有這一天的月份，會跳過該月。</p></div>

            <div class="form-actions"><button type="submit" class="primary" id="submit-button">建立提醒 <span aria-hidden="true">↗</span></button><button type="button" class="text-button" id="cancel-edit" hidden>取消編輯</button></div>
          </form>
        </section>

        <section class="reminders-section" aria-labelledby="list-heading">
          <div class="list-header"><div><p class="eyebrow">YOUR SCHEDULE</p><h2 id="list-heading">提醒清單</h2></div><span id="count" class="count">0 筆</span></div>
          <div class="filters" role="group" aria-label="篩選提醒"><button type="button" class="filter active" data-filter="active">進行中</button><button type="button" class="filter" data-filter="paused">已暫停</button><button type="button" class="filter" data-filter="canceled">已取消</button></div>
          <div id="reminder-list" class="reminder-list"><p class="empty">載入中…</p></div>
        </section>
      </main>
      <footer>本機資料保存在 Cloudflare D1 測試資料庫。實際 LINE 發送尚未啟用。</footer>
    </div>
    <script src="../scripts/app.ts"></script>
  </body>
</html>
