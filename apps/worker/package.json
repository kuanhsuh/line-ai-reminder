{
  "name": "@reminder/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --var LOCAL_MOCK_AUTH:1",
    "db:migrate": "wrangler d1 migrations apply DB --local",
